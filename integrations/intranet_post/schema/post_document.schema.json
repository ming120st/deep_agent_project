{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "An image the post uses. The bytes are produced/uploaded by another module.",
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "filename": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,80}\\.(?:png|jpe?g|gif)$",
          "title": "Filename",
          "type": "string"
        },
        "alt": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        }
      },
      "required": [
        "key",
        "filename"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Bullets": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bullets",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "maxLength": 600,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "ordered": {
          "default": false,
          "title": "Ordered",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "Bullets",
      "type": "object"
    },
    "Callout": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "callout",
          "title": "Type",
          "type": "string"
        },
        "tone": {
          "default": "info",
          "enum": [
            "info",
            "good",
            "warn",
            "danger",
            "neutral"
          ],
          "title": "Tone",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "text": {
          "maxLength": 5000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "Callout",
      "type": "object"
    },
    "Cell": {
      "additionalProperties": false,
      "description": "A table cell with options. Plain strings/numbers are also accepted as cells.",
      "properties": {
        "text": {
          "maxLength": 300,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "info",
                "good",
                "warn",
                "danger",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "text"
      ],
      "title": "Cell",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "align": {
          "default": "left",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "pattern": "^\\d{1,3}(?:%|px)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "label"
      ],
      "title": "Column",
      "type": "object"
    },
    "Divider": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "divider",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Divider",
      "type": "object"
    },
    "Heading": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "heading",
          "title": "Type",
          "type": "string"
        },
        "level": {
          "default": 2,
          "enum": [
            2,
            3
          ],
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "maxLength": 200,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "Heading",
      "type": "object"
    },
    "ImageBlock": {
      "additionalProperties": false,
      "description": "References an entry of ``PostDocument.assets`` by key.",
      "properties": {
        "type": {
          "const": "image",
          "title": "Type",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "alt": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        },
        "caption": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 1200,
              "minimum": 80,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "type",
        "key"
      ],
      "title": "ImageBlock",
      "type": "object"
    },
    "LinkBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "link",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "title": "Text",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text",
        "url"
      ],
      "title": "LinkBlock",
      "type": "object"
    },
    "NewsCard": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "news_card",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "title": "Source",
          "type": "string"
        },
        "published_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Date"
        },
        "summary": {
          "maxLength": 1200,
          "title": "Summary",
          "type": "string"
        },
        "impact": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impact"
        },
        "tags": {
          "items": {
            "maxLength": 16,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Tags",
          "type": "array"
        },
        "image_key": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Key"
        }
      },
      "required": [
        "type",
        "title",
        "url",
        "source",
        "summary"
      ],
      "title": "NewsCard",
      "type": "object"
    },
    "Paragraph": {
      "additionalProperties": false,
      "description": "Plain text. Inline: ``**bold**`` and ``[label](https://url)``. Newlines become line breaks.",
      "properties": {
        "type": {
          "const": "paragraph",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "maxLength": 5000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "Paragraph",
      "type": "object"
    },
    "TableBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "table",
          "title": "Type",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "description": "Each cell is a string, a number, or a Cell object. Numbers are rendered with thousands separators (2026 -> 2,026): use a string for years, ids and phone numbers.",
          "items": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Cell"
                },
                {
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "type": "array"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "style": {
          "$ref": "#/$defs/TableStyle"
        },
        "footnote": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footnote"
        }
      },
      "required": [
        "type",
        "columns",
        "rows"
      ],
      "title": "TableBlock",
      "type": "object"
    },
    "TableStyle": {
      "additionalProperties": false,
      "properties": {
        "striped": {
          "default": true,
          "title": "Striped",
          "type": "boolean"
        },
        "header_tone": {
          "default": "primary",
          "enum": [
            "primary",
            "neutral"
          ],
          "title": "Header Tone",
          "type": "string"
        },
        "first_col_bold": {
          "default": false,
          "title": "First Col Bold",
          "type": "boolean"
        },
        "compact": {
          "default": false,
          "title": "Compact",
          "type": "boolean"
        }
      },
      "title": "TableStyle",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "post_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,79}$",
      "title": "Post Key",
      "type": "string"
    },
    "series": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Series",
      "type": "string"
    },
    "period": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,31}$",
      "title": "Period",
      "type": "string"
    },
    "board": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Board",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "title": "Title",
      "type": "string"
    },
    "theme": {
      "default": "default",
      "title": "Theme",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "maxItems": 20,
      "title": "Assets",
      "type": "array"
    },
    "blocks": {
      "items": {
        "discriminator": {
          "mapping": {
            "bullets": "#/$defs/Bullets",
            "callout": "#/$defs/Callout",
            "divider": "#/$defs/Divider",
            "heading": "#/$defs/Heading",
            "image": "#/$defs/ImageBlock",
            "link": "#/$defs/LinkBlock",
            "news_card": "#/$defs/NewsCard",
            "paragraph": "#/$defs/Paragraph",
            "table": "#/$defs/TableBlock"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Heading"
          },
          {
            "$ref": "#/$defs/Paragraph"
          },
          {
            "$ref": "#/$defs/Bullets"
          },
          {
            "$ref": "#/$defs/Callout"
          },
          {
            "$ref": "#/$defs/ImageBlock"
          },
          {
            "$ref": "#/$defs/LinkBlock"
          },
          {
            "$ref": "#/$defs/NewsCard"
          },
          {
            "$ref": "#/$defs/TableBlock"
          },
          {
            "$ref": "#/$defs/Divider"
          }
        ]
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    }
  },
  "required": [
    "post_key",
    "series",
    "period",
    "board",
    "title",
    "blocks"
  ],
  "title": "PostDocument",
  "type": "object"
}
